# Utilise uniquement par docker-compose (env_file: ./ai-service/.env) - pour
# le dev local sans Docker, ai-service lit deja le .env/.env.local a la racine
# du repo (voir config.py). Copier ce fichier en ai-service/.env pour Docker.
#
# AI_SERVICE_DATABASE_URL n'est volontairement pas ici : docker-compose la
# fixe directement (chemin du volume monte), pas besoin de la dupliquer.

MISTRAL_API_KEY=
MOONSHOT_API_KEY=
VEXA_API_KEY=
VEXA_BASE_URL=https://api.cloud.vexa.ai
GROQ_API_KEY=
GPT_OSS_SAFEGUARD_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
GPT_OSS_SAFEGUARD_MODEL=openai/gpt-oss-safeguard-20b

# Obligatoire - generer par ex. avec `openssl rand -base64 32`.
JWT_SECRET=
