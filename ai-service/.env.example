# Utilise uniquement par docker-compose (env_file: ./ai-service/.env) - pour
# le dev local sans Docker, ai-service lit deja le .env/.env.local a la racine
# du repo (voir config.py). Copier ce fichier en ai-service/.env pour Docker.
#
# AI_SERVICE_DATABASE_URL n'est volontairement pas ici : docker-compose la
# fixe directement (chemin du volume monte), pas besoin de la dupliquer.

# Transcription Voxtral, generation du CR, classification (Chat Completions) et
# moderation (Mistral Moderation 2, endpoint /v1/moderations) - un seul fournisseur.
MISTRAL_API_KEY=
MISTRAL_CHAT_MODEL=mistral-small-latest
MISTRAL_MODERATION_MODEL=mistral-moderation-2603
VEXA_API_KEY=
VEXA_BASE_URL=https://api.cloud.vexa.ai

# OAuth calendrier (auto-join) - voir .env.example (racine) pour le detail et
# l'avertissement sur les redirect URI (origine navi-web, pas ai-service).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=
CALENDAR_SYNC_INTERVAL_MINUTES=5
CALENDAR_LOOKAHEAD_MINUTES=60
CALENDAR_JOIN_LEAD_SECONDS=60
CALENDAR_JOIN_GRACE_SECONDS=300

# Duree de conservation (jours) des preuves de conformite - voir .env.example
# (racine) pour le detail.
CONSENT_RECORD_RETENTION_DAYS=1825
PARTICIPANT_NOTIFICATION_RETENTION_DAYS=1825

# Obligatoire - generer par ex. avec `openssl rand -base64 32`.
JWT_SECRET=
