# Copier ce fichier en .env.local (racine du repo) et renseigner des cles pour
# activer les vraies API. Ce fichier est partage par le Next.js et le service
# FastAPI (ai-service/), qui le charge lui-meme via python-dotenv.
# Sans cles, la demo fonctionne entierement en mode simule (mock) de bout en bout.
#
# Le backend est entierement en Python (ai-service/) : persistance, auth et
# orchestration IA. Next.js est un frontend pur - il ne detient plus aucune
# cle ni logique metier, il proxy juste /api/* vers AI_SERVICE_URL (voir
# next.config.js `rewrites()`).

# URL du service FastAPI (ai-service/) - Next.js y proxy tout /api/* au lieu
# de contenir la moindre logique backend. Par defaut : ai-service lance en local.
AI_SERVICE_URL=http://localhost:8000

# Secret de signature des sessions JWT (cookie httpOnly "navi_session"),
# utilise uniquement cote ai-service - Next.js ne le lit jamais. Obligatoire
# (pas de valeur par defaut) : generer par ex. avec `openssl rand -base64 32`.
JWT_SECRET=

# URL de connexion SQLAlchemy pour la persistance (meetings, users, demandes
# RGPD), geree entierement par ai-service. SQLite par defaut pour le dev/demo.
AI_SERVICE_DATABASE_URL=sqlite:///./navi.db

# Cle API Mistral - utilisee cote FastAPI pour la transcription (Voxtral, mode
# dictaphone), la generation du compte-rendu, la classification (Chat
# Completions) et la moderation (Mistral Moderation 2, endpoint /v1/moderations,
# prompt injection + contenus interdits) : un seul fournisseur/compte pour ces
# quatre usages. https://console.mistral.ai
MISTRAL_API_KEY=
MISTRAL_CHAT_MODEL=mistral-small-latest
MISTRAL_MODERATION_MODEL=mistral-moderation-2603

# Sous-traitant de secours (Scaleway, France/UE) pour la generation du CR et
# la classification uniquement : si Mistral echoue, ces deux clients
# retentent via Scaleway avant de basculer sur le mock. Optionnel - laisser
# vide desactive simplement le fallback (comportement inchange).
# https://console.scaleway.com (Generative APIs)
SCALEWAY_API_KEY=
SCALEWAY_CHAT_MODEL=mistral-small-3.2-24b-instruct-2506

# Fallback transcription auto-heberge (PAS un sous-traitant tiers) - voir le
# commentaire en tete de ai-service/clients/voxtral.py. Non fonctionnel dans
# ce projet (aucune infra GPU provisionnee) : conception documentee, laisser
# vide.
SELF_HOSTED_VOXTRAL_URL=

# Monitoring (Sentry) - optionnel. Cree un projet Python/FastAPI sur
# sentry.io pour obtenir le DSN. Capture automatiquement les exceptions non
# gerees ET tout logger.error(...) existant (bascules mock/secours des
# clients IA) sans changement de code supplementaire. Vide = aucun changement
# de comportement.
SENTRY_DSN=

# Plafond d'usage mensuel reel (en $, cout des sous-traitants factures a
# l'usage - pas le prix facture au client) au-dela duquel /transcribe et
# /visio/join sont rejetes (HTTP 402) pour un compte donne - protection
# contre le scenario "worst case" du plan Pro a prix fixe documente dans
# rapport_technique.md §8. Valeur par defaut alignee sur le prix Pro actuel
# (29,99 EUR/mois) ; a recalculer si ce prix change.
MONTHLY_USAGE_CAP_USD=21.0

# Cle API Vexa (bot de reunion visio : rejoint Meet/Teams/Zoom, transcription +
# diarisation en direct) - API cloud managee. https://docs.vexa.ai
VEXA_API_KEY=
VEXA_BASE_URL=https://api.cloud.vexa.ai

# OAuth calendrier (auto-join des reunions detectees dans l'agenda) - Google
# Calendar (console.cloud.google.com, activer "Google Calendar API") et
# Microsoft Graph (portal.azure.com, enregistrement d'app + permission
# deleguee "Calendars.Read" + "offline_access"). Sans ces cles, la fonction
# d'auto-join calendrier est simplement inactive (pas de fallback mock ici).
#
# Important : les redirect URI doivent pointer vers l'origine PUBLIQUE DU
# FRONTEND NEXT.JS (proxyee vers ai-service via le rewrite /api/*), jamais
# vers le domaine propre d'ai-service - le cookie de session navi_session
# ne circule que via ce rewrite.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/calendar/microsoft/callback

# Frequence de synchronisation des calendriers connectes et fenetre de
# detection/declenchement de l'auto-join (en minutes/secondes).
CALENDAR_SYNC_INTERVAL_MINUTES=5
CALENDAR_LOOKAHEAD_MINUTES=60
CALENDAR_JOIN_LEAD_SECONDS=60
CALENDAR_JOIN_GRACE_SECONDS=300

# Duree de conservation (en jours) des preuves de conformite (ConsentRecord,
# ParticipantNotification) une fois la reunion correspondante deja
# anonymisee. Defaut : 5 ans, aligne sur la prescription civile de droit
# commun (art. 2224 Code civil) - pas une preconisation CNIL chiffree, a
# valider explicitement selon l'analyse de risque du projet (cf. config.py).
CONSENT_RECORD_RETENTION_DAYS=1825
PARTICIPANT_NOTIFICATION_RETENTION_DAYS=1825
